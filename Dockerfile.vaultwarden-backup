ARG ALPINE_DIGEST=sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
ARG GOLANG_DIGEST=sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523

FROM --platform=$BUILDPLATFORM alpine@${ALPINE_DIGEST} AS verifier

ARG COMMIT_HASH

RUN apk add --no-cache git ca-certificates

WORKDIR /verify

RUN git init . && \
    git remote add origin https://github.com/rclone/rclone.git && \
    git fetch --depth 1 origin "${COMMIT_HASH}" && \
    git checkout FETCH_HEAD

FROM --platform=$BUILDPLATFORM golang@${GOLANG_DIGEST} AS builder

ARG VERSION
ARG TARGETARCH

WORKDIR /src

COPY --from=verifier /verify/ ./

RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -ldflags="-w -s -X github.com/rclone/rclone/fs.Version=${VERSION}" -o rclone

FROM alpine@${ALPINE_DIGEST} AS runtime

# GPG and Python run the complete backup inside the image. No hardware is needed
# for public-key encryption; Python's SQLite backup API handles the live WAL.
RUN apk add --no-cache ca-certificates gnupg python3 tar gzip tzdata && \
    addgroup -g 1000 nonroot && \
    adduser -D -H -u 1000 -G nonroot nonroot && \
    mkdir -p /config/backup /config/rclone /backup-state && \
    chown 1000:1000 /backup-state

COPY --chmod=755 scripts/backup.sh scripts/restore.sh scripts/vaultwarden_backup.py /usr/local/bin/

FROM runtime

COPY --from=builder /src/rclone /usr/local/bin/rclone

USER 1000:1000

ENV TZ=Asia/Bangkok

ENTRYPOINT ["/usr/local/bin/backup.sh"]
CMD ["backup"]
