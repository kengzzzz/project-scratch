ARG ALPINE_DIGEST=sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
ARG DEBIAN_DIGEST=sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0

FROM alpine@${ALPINE_DIGEST} AS alpine-base
FROM debian@${DEBIAN_DIGEST} AS debian-base

FROM alpine-base AS verifier

ARG COMMIT_HASH

RUN apk add --no-cache git ca-certificates

WORKDIR /verify

RUN git init . && \
    git remote add origin https://github.com/NLnetLabs/unbound.git && \
    git fetch --depth 1 origin "${COMMIT_HASH}" && \
    git checkout FETCH_HEAD

FROM debian-base AS builder

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    lld \
    llvm \
    bison \
    flex \
    libevent-dev \
    libssl-dev \
    libexpat1-dev \
    libhiredis-dev \
    libnghttp2-dev \
    zlib1g-dev \
    libzstd-dev \
    pkg-config \
    ca-certificates \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY --from=verifier /verify/ ./

ENV CC="clang" \
    CXX="clang++" \
    AR="llvm-ar" \
    NM="llvm-nm" \
    RANLIB="llvm-ranlib" \
    CPPFLAGS="-D_FORTIFY_SOURCE=3"

RUN case "$(uname -m)" in \
        aarch64|arm64) OPT_FLAG="-mcpu=native" ;; \
        x86_64|amd64) OPT_FLAG="-march=native" ;; \
        *) echo "Unsupported build architecture for native CPU tuning: $(uname -m)" >&2; exit 1 ;; \
    esac && \
    export CFLAGS="-O3 $OPT_FLAG -flto -fstack-protector-strong -fPIE -fno-math-errno -fno-trapping-math" && \
    export LDFLAGS="-fuse-ld=lld -static-pie -flto -Wl,-O3 -Wl,-z,now -Wl,-z,relro -lzstd -lz" && \
    ./configure --with-run-dir=/tmp --with-pidfile=/tmp/unbound.pid --disable-shared --enable-fully-static --enable-cachedb --with-libhiredis --with-libnghttp2=/usr --with-libevent=/usr --with-pthreads --enable-tfo-client && \
    make -j "$(nproc)"

RUN mkdir -p /rootfs/usr/local/sbin /rootfs/etc/ssl/certs /rootfs/usr/share/zoneinfo/Asia /rootfs-writable/tmp /rootfs-writable/usr/local/etc/unbound && \
    cp unbound unbound-control unbound-checkconf /rootfs/usr/local/sbin/ && llvm-strip -s /rootfs/usr/local/sbin/* && \
    cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ && cp /usr/share/zoneinfo/Asia/Bangkok /rootfs/usr/share/zoneinfo/Asia/ && \
    echo "unbound:x:1000:1000:unbound:/nonexistent:/sbin/nologin" > /rootfs/etc/passwd && echo "unbound:x:1000:" > /rootfs/etc/group && \
    curl -fsS --retry 3 --retry-all-errors --max-time 60 -o /rootfs-writable/usr/local/etc/unbound/root.hints https://www.internic.net/domain/named.cache && \
    (./unbound-anchor -a /rootfs-writable/usr/local/etc/unbound/root.key || :) && \
    test -s /rootfs-writable/usr/local/etc/unbound/root.hints && \
    test -s /rootfs-writable/usr/local/etc/unbound/root.key

FROM scratch AS exporter

COPY --from=builder /rootfs/ /

COPY --from=builder --chown=1000:1000 /rootfs-writable/ /

FROM scratch

COPY --from=exporter / /

USER 1000:1000

ENV TZ=Asia/Bangkok

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["unbound-control", "-c", "/usr/local/etc/unbound/unbound.conf", "status"]

ENTRYPOINT ["unbound"]
CMD ["-d", "-c", "/usr/local/etc/unbound/unbound.conf"]
